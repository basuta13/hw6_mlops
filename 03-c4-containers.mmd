  classDef container fill:#438dd5,stroke:#2e6295,color:#ffffff;
  classDef mlc fill:#e65100,stroke:#a63a00,color:#ffffff,stroke-width:3px;
  classDef db fill:#438dd5,stroke:#2e6295,color:#ffffff;
  classDef ext fill:#8c8c8c,stroke:#6b6b6b,color:#ffffff;
  classDef note fill:#ffffff,stroke:#bbbbbb,color:#111;
